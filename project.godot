; KS3 — Godot 4.5+ project configuration
; Open this repository folder directly in Godot 4.5 or newer.
config_version=5

[application]
config/name="KS3 // Командный центр"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0.035, 0.055, 0.075, 1)
boot_splash/show_image=false

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/size/window_width_override=1440
window/size/window_height_override=900
window/size/resizable=false
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[gui]
theme/default_font_multichannel_signed_distance_field=true

[physics]
common/physics_ticks_per_second=128

